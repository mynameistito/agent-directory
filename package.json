{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@mynameistito/agent-directory",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "bun build src/worker.ts --target browser --outfile dist/index.js",
    "check": "ultracite check",
    "deploy": "bunx --no-install alchemy deploy --stage \"$STAGE\" --yes",
    "destroy": "bunx --no-install alchemy destroy --stage \"$STAGE\" --yes",
    "dev": "alchemy dev",
    "knip": "knip",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "ultracite": "8.1.1",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}

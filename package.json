{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@mynameistito/agent-directory",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "bun build src/worker.ts --target browser --outfile dist/index.js",
    "check": "ultracite check",
    "deploy": "bunx --no-install alchemy deploy --stage \"$STAGE\" --yes",
    "destroy": "bunx --no-install alchemy destroy --stage \"$STAGE\" --yes",
    "dev": "alchemy dev",
    "knip": "knip",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.2",
    "vitest": "5.0.2"
  },
  "packageManager": "bun@1.4.2"
}

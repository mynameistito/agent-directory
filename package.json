{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@mynameistito/agent-directory",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "bun build src/worker.ts --target browser --outfile dist/index.js",
    "check": "ultracite check",
    "deploy": "bunx --no-install alchemy deploy --stage \"$STAGE\" --yes",
    "destroy": "bunx --no-install alchemy destroy --stage \"$STAGE\" --yes",
    "dev": "alchemy dev",
    "knip": "knip",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.2"
}
